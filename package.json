{
  "name": "inkwave",
  "productName": "INKWAVE",
  "version": "1.1.0",
  "description": "An original Splatoon-style 4v4 turf-war shooter for the browser, built on three.js.",
  "scripts": {
    "start": "tauri dev --no-watch --no-dev-server",
    "desktop:typecheck": "tsc -p tsconfig.desktop.json && tsc -p tsconfig.desktop-tools.json --noEmit",
    "desktop:prepare": "npm run desktop:typecheck && tsc -p tsconfig.desktop-tools.json && node .desktop-tools/prepare.js",
    "desktop:check": "npm run desktop:prepare && node .desktop-tools/check-dist.js && cd src-tauri && cargo check --locked --features custom-protocol --jobs 2",
    "dev": "tsc -p tsconfig.client-tools.json && node .tools/dev.js",
    "serve": "tsc -p tsconfig.client-tools.json && node .tools/dev.js --no-watch",
    "compile": "tsc -p tsconfig.client-tools.json && node .tools/dev.js --once",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.client-tools.json --noEmit",
    "check": "node tools/check-syntax.mjs",
    "test:client": "tsc -p tsconfig.client-tools.json && node .tools/test.js",
    "verify": "npm run typecheck && npm run check && npm run test:client && npm run build",
    "package": "tauri build",
    "music": "node build/music-manifest.mjs",
    "bake": "electron build/bake-ao.cjs",
    "check-maps": "node build/check-maps.mjs",
    "icon": "sh build/make-icon.sh",
    "botlab": "tools/botlab/run.sh tools/botlab/match.cjs",
    "smoke": "tsc -p tsconfig.client-tools.json && node .tools/smoke.js",
    "smoke:dist": "tsc -p tsconfig.client-tools.json && node .tools/smoke.js --port 8493 --dir dist",
    "net-test": "node tools/net-test.mjs",
    "build": "npm run compile && node tools/py.mjs tools/build-dist.py",
    "release": "./tools/release-pages.sh",
    "deploy-relay": "cd server && wrangler deploy",
    "relay": "cd server && wrangler dev --ip 0.0.0.0 --port 8787"
  },
  "keywords": [
    "game",
    "three.js",
    "webgl",
    "shooter",
    "splatoon",
    "turf-war",
    "browser-game"
  ],
  "author": "Jayden Davis",
  "license": "MIT",
  "type": "module",
  "homepage": "https://inkwave-aah.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaydendavisnc/inkwave.git"
  },
  "bugs": {
    "url": "https://github.com/jaydendavisnc/inkwave/issues"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.5",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "electron": "^44.4.5",
    "esbuild": "0.25.12",
    "puppeteer-core": "^25.12.0",
    "typescript": "5.9.3",
    "wrangler": "^4.141.0"
  }
}
